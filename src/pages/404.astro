---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — NovaNode Australia">
  <section class="section"><div class="wrap" style="display:grid;gap:16px;max-width:640px">
    <h1 style="font-size:var(--step-3)">That page doesn’t exist.</h1>
    <p>The link may be old or mistyped. Start from the home page, or pick your business to see a demo.</p>
    <p><a class="btn btn-primary" href="/#pick">Pick your business</a></p>
  </div></section>
</Base>
